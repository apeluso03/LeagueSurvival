# Backend settings (read from backend/.env or the environment)
RIOT_API_KEY=
DATABASE_URL=sqlite:///./survival.db
# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# The game client's Live Client Data API (live stats). "off" turns it off.
LIVE_CLIENT_URL=https://127.0.0.1:2999
# Hosted: serve the built frontend from the backend (the Dockerfile sets this)
# FRONTEND_DIST=/app/frontend/dist
